-- =====================================================
-- Query 1
-- Display customer names and email addresses
-- =====================================================

SELECT
    name,
    email
FROM customers;

-- =====================================================
-- Query 2
-- Retrieve complete product information
-- =====================================================

SELECT *
FROM products;

-- =====================================================
-- Query 3
-- Display available product categories
-- =====================================================

SELECT DISTINCT category
FROM products;

-- =====================================================
-- Query 4
-- Find products costing more than ₹1,000
-- =====================================================

SELECT *
FROM products
WHERE price > 1000;

-- =====================================================
-- Query 5
-- Show products with prices between ₹2,000 and ₹5,000
-- =====================================================

SELECT *
FROM products
WHERE price BETWEEN 2000 AND 5000;

-- =====================================================
-- Query 6
-- Retrieve details of selected customers
-- =====================================================

SELECT *
FROM customers
WHERE customer_id IN (5, 8, 12, 18, 25);

-- =====================================================
-- Query 7
-- Find customers whose names begin with 'A'
-- =====================================================

SELECT *
FROM customers
WHERE name LIKE 'A%';

-- =====================================================
-- Query 8
-- List products priced below ₹3,000
-- =====================================================

SELECT *
FROM products
WHERE price < 3000;

-- =====================================================
-- Query 9
-- Display product names with prices
-- ordered from highest to lowest
-- =====================================================

SELECT
    name,
    price
FROM products
ORDER BY price DESC;

-- =====================================================
-- Query 10
-- Sort products by price, then alphabetically by name
-- =====================================================

SELECT
    name,
    price
FROM products
ORDER BY
    price ASC,
    name ASC;

-- ===================== End of Basic SQL Queries =====================

