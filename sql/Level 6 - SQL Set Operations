-- =====================================================
-- Query 1
-- Retrieve customers who have either placed an order
-- or submitted a product review
-- (UNION removes duplicate records)
-- =====================================================

SELECT
    c.customer_id,
    c.name AS customer_name,
    c.email
FROM customers AS c
INNER JOIN orders AS o
ON c.customer_id = o.customer_id

UNION

SELECT
    c.customer_id,
    c.name AS customer_name,
    c.email
FROM customers AS c
INNER JOIN product_reviews AS pr
ON c.customer_id = pr.customer_id;

-- =====================================================
-- Query 2
-- Display customers who have both placed orders
-- and submitted product reviews
-- (INTERSECT equivalent using INNER JOIN)
-- =====================================================

SELECT DISTINCT
    c.customer_id,
    c.name AS customer_name,
    c.email
FROM customers AS c
INNER JOIN orders AS o
ON c.customer_id = o.customer_id
INNER JOIN product_reviews AS pr
ON c.customer_id = pr.customer_id;

