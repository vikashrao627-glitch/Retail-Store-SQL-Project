-- =====================================================
-- Query 1
-- Identify orders that do not have matching customer records
-- =====================================================

SELECT
    o.order_id,
    o.customer_id,
    o.order_date,
    o.status,
    o.total_amount
FROM orders AS o
LEFT JOIN customers AS c
ON o.customer_id = c.customer_id
WHERE c.customer_id IS NULL;

-- =====================================================
-- Query 2
-- Display customer details with user-friendly column names
-- =====================================================

SELECT
    name AS customer_name,
    email AS customer_email
FROM customers;

-- =====================================================
-- Query 3
-- Calculate the total amount for each ordered product
-- =====================================================

SELECT
    order_item_id,
    order_id,
    product_id,
    quantity,
    item_price,
    (quantity * item_price) AS line_total
FROM order_items;

-- =====================================================
-- Query 4
-- Merge customer name and phone number into one field
-- =====================================================

SELECT
    customer_id,
    CONCAT(name, ' | ', phone) AS contact_details
FROM customers;

